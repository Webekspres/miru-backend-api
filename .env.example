# ===========================================================================
# MIRU Bank Sampah  Backend Environment Variables
# Copy file ini ke .env dan isi nilai yang sesuai
# ===========================================================================

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
USE_POSTGRES=True
DB_NAME=miru
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=db
DB_PORT=5432
# Local runserver: keep 0 (default when DEBUG=True). Production: 300.
# CONN_MAX_AGE=0

# CORS  ganti dengan domain frontend yang sebenarnya
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://admin.mirubanksampah.id,https://mirubanksampah.id

# --- Production-only (wajib diisi saat DEBUG=False) ---
# ALLOWED_HOSTS=api.mirubanksampah.id,localhost
# SECRET_KEY=<generate-unique-64-char-random>

# Monitoring & Healthcheck (Fase 7.4)
# HEALTH_URL=http://localhost:8000/health/
# ALERT_EMAIL=admin@mirubanksampah.id
# SLACK_WEBHOOK=https://hooks.slack.com/services/your/webhook/here

# Email transactional (Fase 8.6)  kosongkan = console backend (dev)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=MIRU Bank Sampah <noreply@mirubanksampah.id>
# ADMIN_NOTIF_EMAIL=admin@mirubanksampah.id

# Firebase Cloud Messaging (Fase 8.6)  JANGAN commit file/JSON kredensial
# FCM_ENABLED=True
# FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase-sa.json
# FIREBASE_CREDENTIALS_JSON=   # alternatif: isi JSON service account (satu baris)

# WhatsApp OTP (T2)  kosongkan = stub/log (tidak kirim nyata; jangan log OTP)
# WA_API_URL=https://provider.example.com/v1/messages
# WA_API_TOKEN=
# WA_SENDER=

# OTP tetap local/dev (lihat docs/OTP_DEV.md) — HANYA aktif jika DEBUG=True
# Isi 6 digit; diabaikan otomatis saat DEBUG=False (production).
# OTP_DEV_FIXED_CODE=123456

# Skip phone verification — untuk internal testing tanpa WA gateway.
# Saat True, request-otp langsung verifikasi tanpa perlu kode OTP.
# Hanya gunakan di staging/testing; JANGAN aktifkan di production.
# SKIP_PHONE_VERIFICATION=True

# MinIO  object storage publik (gambar artikel edukasi)
# Kosongkan MINIO_ENDPOINT = simpan ke MEDIA_ROOT (berguna untuk tes tanpa Docker).
# Django di host (runserver): MINIO_ENDPOINT=http://localhost:9000
# Django di Docker Compose: override otomatis ke http://minio:9000
# MINIO_PUBLIC_URL kosong = URL dibangun dari host request (/objects/...)
#   sehingga mobile (10.0.2.2 / IP LAN) tetap bisa memuat gambar.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mirubanksampah
MINIO_REGION=us-east-1
# MINIO_PUBLIC_URL=https://cdn.mirubanksampah.id

# Backup (scripts/backup.sh, restore.sh, test_restore.sh)
# Generate a strong passphrase and keep it only in .env / password manager.
# GPG_PASSPHRASE=
# Local default is <repo>/backups/daily. Production:
# BACKUP_DIR=/opt/miru/backups/daily
# RETENTION_DAYS=30
# Optional off-server weekly copy (backup_weekly.sh):
# REMOTE_HOST=backup.mirubanksampah.id
# REMOTE_USER=backup
# REMOTE_PATH=/backup/miru
# If pg_dump is not on PATH, scripts exec into the container publishing DB_PORT:
# PG_CONTAINER=
