openapi: 3.0.3
info:
  title: MIRU Bank Sampah API
  version: 1.0.0
  description: 'REST API untuk sistem MIRU Bank Sampah, Distrik Mimika Baru. Semua
    response menggunakan JSON Envelope (`success`, `status_code`, `message`, `data`,
    `meta`). Panduan alur per role: `/api/guide/`. Akun demo (setelah `seed_data`):
    `admin/admin123`, `nasabah001/nasabah123`, `petugas1/petugas123`, `koordinator/koordinator123`.'
paths:
  /api/auth/login/:
    post:
      operationId: auth_login_create
      description: 'Autentikasi JWT. Response berisi `access`, `refresh`, dan profil
        singkat user. Akun demo: `admin/admin123`, `nasabah001/nasabah123`, `petugas1/petugas123`.'
      summary: Login — dapatkan access & refresh token
      tags:
      - Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/MiruTokenObtainPairRequest'
            examples:
              AkunDemo(setelahSeedData):
                value:
                  username: nasabah001
                  password: nasabah123
                summary: Akun demo (setelah seed_data)
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/MiruTokenObtainPairRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/MiruTokenObtainPairRequest'
        required: true
      responses:
        '200':
          description: No response body
  /api/auth/me/:
    get:
      operationId: auth_me_retrieve
      description: Ambil profil lengkap user dari JWT. Nasabah tidak bisa ubah role/saldo/poin.
      summary: Profil user yang sedang login
      tags:
      - Auth
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserProfile'
          description: ''
    patch:
      operationId: auth_me_partial_update
      description: Update nama, no HP, atau alamat profil user login.
      summary: Perbarui profil sendiri
      tags:
      - Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserProfile'
          description: ''
  /api/auth/refresh/:
    post:
      operationId: auth_refresh_create
      description: Perbarui access token menggunakan refresh token dari login.
      summary: Refresh access token
      tags:
      - Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequest'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenRefresh'
          description: ''
  /api/complaints/:
    get:
      operationId: complaints_list
      summary: Daftar pengaduan
      parameters:
      - in: query
        name: nasabah
        schema:
          type: integer
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
          enum:
          - ditutup
          - terbuka
        description: |-
          * `terbuka` - Terbuka
          * `ditutup` - Ditutup
      tags:
      - Complaints
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedPengaduanList'
          description: ''
    post:
      operationId: complaints_create
      summary: Kirim pengaduan (nasabah)
      tags:
      - Complaints
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PengaduanRequest'
            examples:
              PengaduanSaldo:
                value:
                  jenis_pengaduan: saldo_belum_masuk
                  isi_pengaduan: Setoran kemarin belum masuk ke saldo.
                summary: Pengaduan saldo
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PengaduanRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PengaduanRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Pengaduan'
          description: ''
  /api/complaints/{id}/:
    get:
      operationId: complaints_retrieve
      summary: Detail pengaduan
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this pengaduan.
        required: true
      tags:
      - Complaints
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Pengaduan'
          description: ''
    put:
      operationId: complaints_update
      summary: Perbarui pengaduan
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this pengaduan.
        required: true
      tags:
      - Complaints
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PengaduanRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PengaduanRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PengaduanRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Pengaduan'
          description: ''
    patch:
      operationId: complaints_partial_update
      summary: Perbarui pengaduan
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this pengaduan.
        required: true
      tags:
      - Complaints
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedPengaduanRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedPengaduanRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedPengaduanRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Pengaduan'
          description: ''
    delete:
      operationId: complaints_destroy
      summary: Hapus pengaduan
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this pengaduan.
        required: true
      tags:
      - Complaints
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '204':
          description: No response body
