  /api/pickups/:
    get:
      operationId: pickups_list
      summary: Daftar penjemputan
      parameters:
      - in: query
        name: nasabah
        schema:
          type: integer
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: petugas
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
          enum:
          - dijadwalkan
          - dijemput
          - disetujui
          - ditolak
          - menunggu
          - selesai
        description: |-
          * `menunggu` - Menunggu
          * `disetujui` - Disetujui
          * `dijadwalkan` - Dijadwalkan
          * `dijemput` - Dijemput
          * `selesai` - Selesai
          * `ditolak` - Ditolak
      tags:
      - Pickups
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedPenjemputanList'
          description: ''
    post:
      operationId: pickups_create
      summary: Ajukan penjemputan (nasabah)
      tags:
      - Pickups
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PenjemputanRequest'
            examples:
              AjuanPenjemputan:
                value:
                  estimasi_berat: '8.00'
                  alamat_jemput: Jl. Cendrawasih, Timika
                  jadwal: '2026-07-08T09:00:00+09:00'
                  catatan: Sampah sudah dipilah
                summary: Ajuan penjemputan
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PenjemputanRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PenjemputanRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Penjemputan'
          description: ''
