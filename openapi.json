components:
  schemas:
    DetailSetoranRead:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        kategori:
          type: integer
        kategori_nama:
          type: string
          readOnly: true
        berat_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
        harga_saat_itu:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        subtotal:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
      required:
      - berat_kg
      - harga_saat_itu
      - id
      - kategori
      - kategori_nama
      - subtotal
    DetailSetoranWrite:
      type: object
      properties:
        kategori:
          type: integer
        berat_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
      required:
      - berat_kg
      - kategori
    DetailSetoranWriteRequest:
      type: object
      properties:
        kategori:
          type: integer
        berat_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
      required:
      - berat_kg
      - kategori
    JenisPengaduanEnum:
      enum:
      - saldo_belum_masuk
      - penjemputan_terlambat
      - berat_tidak_sesuai
      - harga_tidak_sesuai
      - petugas_tidak_datang
      - kesalahan_data
      - bukti_tidak_muncul
      - lainnya
      type: string
      description: '* `saldo_belum_masuk` - Saldo Belum Masuk

        * `penjemputan_terlambat` - Penjemputan Terlambat

        * `berat_tidak_sesuai` - Berat Tidak Sesuai

        * `harga_tidak_sesuai` - Harga Tidak Sesuai

        * `petugas_tidak_datang` - Petugas Tidak Datang

        * `kesalahan_data` - Kesalahan Data

        * `bukti_tidak_muncul` - Bukti Tidak Muncul'
      properties: {}
    KategoriSampah:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        nama:
          type: string
          maxLength: 100
        harga_beli_per_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
        stok_terkini_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          readOnly: true
      required:
      - harga_beli_per_kg
      - id
      - nama
      - stok_terkini_kg
    KategoriSampahRequest:
      type: object
      properties:
        nama:
          type: string
          minLength: 1
          maxLength: 100
        harga_beli_per_kg:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
      required:
      - harga_beli_per_kg
      - nama
    MiruTokenObtainPairRequest:
      type: object
      properties:
        username:
          type: string
          writeOnly: true
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - password
      - username
    MitraPengepul:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        nama:
          type: string
          maxLength: 100
        kontak:
          type: string
          maxLength: 50
      required:
      - id
      - kontak
      - nama
    MitraPengepulRequest:
      type: object
      properties:
        nama:
          type: string
          minLength: 1
          maxLength: 100
        kontak:
          type: string
          minLength: 1
          maxLength: 50
      required:
      - kontak
      - nama
    PaginatedKategoriSampahList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?page=4
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?page=2
        results:
          type: array
          items:
            $ref: '#/components/schemas/KategoriSampah'
    PaginatedMitraPengepulList:
