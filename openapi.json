      - created_at
      - deskripsi
      - id
      - judul
      - kategori
      - user
    NotifikasiRequest:
      type: object
      properties:
        is_read:
          type: boolean
    PaginatedKontenEdukasiPublicList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?page=4
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?page=2
        results:
          type: array
          items:
            $ref: '#/components/schemas/KontenEdukasiPublic'
    PaginatedNotifikasiList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?page=4
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?page=2
        results:
          type: array
          items:
            $ref: '#/components/schemas/Notifikasi'
    PaginatedWilayahLayananList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?page=4
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?page=2
        results:
          type: array
          items:
            $ref: '#/components/schemas/WilayahLayanan'
    PatchedKontenEdukasiRequest:
      type: object
      description: CRUD konten edukasi — admin/koordinator.
      properties:
        judul:
          type: string
          minLength: 1
          maxLength: 200
        isi:
          type: string
          minLength: 1
          description: Isi konten/panduan edukasi
        kategori_terkait:
          type: integer
          nullable: true
          description: Kategori sampah terkait (opsional)
        aktif:
          type: boolean
        urutan:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          description: Urutan tampil (ascending)
    PatchedNotifikasiRequest:
      type: object
      properties:
        is_read:
          type: boolean
    PatchedPengaturanInstitusiRequest:
      type: object
      properties:
        nama_institusi:
          type: string
          minLength: 1
          maxLength: 255
        alamat:
          type: string
        kontak:
          type: string
          maxLength: 50
        email:
          type: string
          format: email
          maxLength: 254
        logo_url:
          type: string
          format: uri
          nullable: true
          maxLength: 200
        jam_operasional:
          type: string
          description: Deprecated — prefer jam_buka/jam_tutup. Disinkron otomatis saat jam_buka & jam_tutup
            diisi.
          maxLength: 255
        pengumuman:
          type: string
        jam_buka:
          type: string
          format: time
          nullable: true
          description: Jam buka layanan (WIT), format HH:MM:SS
        jam_tutup:
          type: string
          format: time
          nullable: true
          description: Jam tutup layanan (WIT), format HH:MM:SS
    PatchedTransaksiSetoranCorrectionRequest:
      type: object
      description: 'Admin-only: koreksi data transaksi setoran.'
      properties:
        total_nilai:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
    PatchedWilayahLayananRequest:
      type: object
      description: CRUD wilayah layanan — admin/koordinator.
      properties:
        kelurahan:
          type: string
          minLength: 1
          maxLength: 100
        rt:
          type: string
          description: RT (opsional)
          maxLength: 10
        rw:
          type: string
          description: RW (opsional)
          maxLength: 10
        aktif:
          type: boolean
          description: Wilayah yang masih dilayani
    PlatformEnum:
      enum:
      - android
      - ios
      - web
      type: string
      description: '* `android` - android

        * `ios` - ios

        * `web` - web'
    TransaksiSetoranCorrection:
      type: object
      description: 'Admin-only: koreksi data transaksi setoran.'
      properties:
        total_nilai:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
    WilayahLayanan:
      type: object
      description: CRUD wilayah layanan — admin/koordinator.
      properties:
        id:
          type: integer
          readOnly: true
        kelurahan:
          type: string
          maxLength: 100
        rt:
          type: string
          description: RT (opsional)
          maxLength: 10
        rw:
          type: string
          description: RW (opsional)
          maxLength: 10
        aktif:
          type: boolean
          description: Wilayah yang masih dilayani
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - kelurahan
    WilayahLayananRequest:
      type: object
      description: CRUD wilayah layanan — admin/koordinator.
      properties:
        kelurahan:
          type: string
          minLength: 1
          maxLength: 100
        rt:
          type: string
          description: RT (opsional)
          maxLength: 10
        rw:
          type: string
          description: RW (opsional)
          maxLength: 10
        aktif:
          type: boolean
          description: Wilayah yang masih dilayani
      required:
      - kelurahan
