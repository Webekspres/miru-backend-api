openapi: 3.0.3
info:
  title: MIRU Bank Sampah API
  version: 1.0.0
  description: 'REST API untuk sistem MIRU Bank Sampah, Distrik Mimika Baru. Semua response menggunakan
    JSON Envelope (`success`, `status_code`, `message`, `data`, `meta`). Panduan alur per role: `/api/guide/`.
    Akun demo (setelah `seed_data`): `admin/admin123`, `nasabah001/nasabah123`, `petugas1/petugas123`,
    `koordinator/koordinator123`.'
paths:
  /api/activity/:
    get:
      operationId: activity_retrieve
      summary: Riwayat transaksi gabungan (setoran, penarikan, penukaran poin)
      tags:
      - Activity
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/auth/login/:
    post:
      operationId: auth_login_create
      description: 'Autentikasi JWT. Response berisi `access`, `refresh`, dan profil singkat user. Akun
        demo: `admin/admin123`, `nasabah001/nasabah123`, `petugas1/petugas123`.'
      summary: Login — dapatkan access & refresh token
      tags:
      - Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/MiruTokenObtainPairRequest'
            examples:
              AkunDemo(setelahSeedData):
                value:
                  username: nasabah001
                  password: nasabah123
                summary: Akun demo (setelah seed_data)
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/MiruTokenObtainPairRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/MiruTokenObtainPairRequest'
        required: true
      responses:
        '200':
          description: No response body
  /api/auth/me/:
    get:
      operationId: auth_me_retrieve
      description: Ambil profil lengkap user dari JWT. Termasuk field `qr` ({ id, nama_lengkap, no_hp
        }) untuk kartu digital. Nasabah tidak bisa ubah role/saldo/poin via PATCH.
      summary: Profil user yang sedang login
      tags:
      - Auth
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserProfile'
          description: ''
    patch:
      operationId: auth_me_partial_update
      description: Update nama, no HP, atau alamat profil user login.
      summary: Perbarui profil sendiri
      tags:
      - Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUserProfileRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserProfile'
          description: ''
  /api/auth/refresh/:
    post:
      operationId: auth_refresh_create
      description: Perbarui access token menggunakan refresh token dari login.
      summary: Refresh access token
      tags:
      - Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TokenRefreshRequest'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenRefresh'
          description: ''
  /api/complaints/:
    get:
      operationId: complaints_list
      summary: Daftar pengaduan
      parameters:
      - in: query
        name: jenis_pengaduan
        schema:
          type: string
          enum:
          - berat_tidak_sesuai
          - bukti_tidak_muncul
          - harga_tidak_sesuai
          - kesalahan_data
          - penjemputan_terlambat
          - petugas_tidak_datang
          - saldo_belum_masuk
        description: '* `saldo_belum_masuk` - Saldo Belum Masuk

          * `penjemputan_terlambat` - Penjemputan Terlambat

          * `berat_tidak_sesuai` - Berat Tidak Sesuai

          * `harga_tidak_sesuai` - Harga Tidak Sesuai

          * `petugas_tidak_datang` - Petugas Tidak Datang

          * `kesalahan_data` - Kesalahan Data

          * `bukti_tidak_muncul` - Bukti Tidak Muncul'
      - in: query
        name: nasabah
        schema:
          type: integer
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
          enum:
          - ditutup
          - terbuka
        description: '* `terbuka` - Terbuka

          * `ditutup` - Ditutup'
      tags:
      - Complaints
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedPengaduanList'
          description: ''
    post:
      operationId: complaints_create
      summary: Kirim pengaduan (nasabah)
      tags:
      - Complaints
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PengaduanCreateRequest'
            examples:
              PengaduanSaldo:
                value:
                  jenis_pengaduan: saldo_belum_masuk
                  isi_pengaduan: Setoran kemarin belum masuk ke saldo.
                summary: Pengaduan saldo
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PengaduanCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PengaduanCreateRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PengaduanCreate'
          description: ''
  /api/complaints/{id}/:
    get:
      operationId: complaints_retrieve
      summary: Detail pengaduan
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this pengaduan.
        required: true
      tags:
      - Complaints
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Pengaduan'
          description: ''
    patch:
      operationId: complaints_partial_update
      summary: Perbarui pengaduan
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this pengaduan.
        required: true
      tags:
      - Complaints
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedPengaduanUpdateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedPengaduanUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedPengaduanUpdateRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PengaduanUpdate'
          description: ''
  /api/dashboard/deposit-chart/:
    get:
      operationId: dashboard_deposit_chart_retrieve
      description: Total nilai, berat, dan jumlah transaksi per hari untuk satu bulan.
      summary: Data setoran harian untuk chart
      tags:
      - Dashboard
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/dashboard/overview/:
    get:
      operationId: dashboard_overview_retrieve
      description: 'Data agregat untuk dashboard: total nasabah, nasabah aktif 30 hari, total sampah &
        nilai setoran, penarikan, penukaran poin, penjemputan menunggu, pengaduan terbuka, dan stok per
        kategori.'
      summary: Ringkasan monitoring program (admin/koordinator/pemerintah)
      tags:
      - Dashboard
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/dashboard/recent-activity/:
    get:
      operationId: dashboard_recent_activity_retrieve
      description: Gabungan setoran, penarikan, dan penjemputan terbaru, urut waktu.
      summary: Aktivitas transaksi terbaru
      tags:
      - Dashboard
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/deposits/:
    get:
      operationId: deposits_list
      summary: Daftar transaksi setoran
      parameters:
      - in: query
        name: nasabah
        schema:
          type: integer
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
      - in: query
        name: tanggal_after
        schema:
          type: string
          format: date
      - in: query
        name: tanggal_before
        schema:
          type: string
          format: date
      tags:
      - Deposits
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedTransaksiSetoranReadList'
          description: ''
    post:
      operationId: deposits_create
      summary: Catat setoran sampah (petugas/admin)
      tags:
      - Deposits
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TransaksiSetoranCreateRequest'
            examples:
              SetoranNasabah:
                value:
                  nasabah: 5
                  details:
                  - kategori: 1
                    berat_kg: '5.00'
                  - kategori: 3
                    berat_kg: '3.50'
                summary: Setoran nasabah
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TransaksiSetoranCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TransaksiSetoranCreateRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TransaksiSetoranCreate'
          description: ''
  /api/deposits/{id}/:
    get:
      operationId: deposits_retrieve
      summary: Bukti digital setoran
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this transaksi setoran.
        required: true
      tags:
      - Deposits
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TransaksiSetoranRead'
          description: ''
  /api/inventory/:
    get:
      operationId: inventory_retrieve
      description: Base view for admin/koordinator/pemerintah read-only monitoring.
      summary: Ringkasan stok gudang semua kategori
      tags:
      - Inventory
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/inventory/{kategori_id}/history/:
    get:
      operationId: inventory_history_retrieve
      description: Gabungan pergerakan stok dari setoran (masuk) dan penjualan ke mitra (keluar), diurutkan
        terbaru dulu.
      summary: Riwayat perubahan stok per kategori
      parameters:
      - in: path
        name: kategori_id
        schema:
          type: integer
        required: true
      tags:
      - Inventory
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/partner-sales/:
    get:
      operationId: partner_sales_list
      summary: Daftar penjualan ke mitra
      parameters:
      - in: query
        name: kategori
        schema:
          type: integer
      - in: query
        name: mitra
        schema:
          type: integer
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - Partner Sales
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedPenjualanMitraList'
          description: ''
    post:
      operationId: partner_sales_create
      summary: Catat penjualan stok ke mitra (admin)
      tags:
      - Partner Sales
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PenjualanMitraCreateRequest'
            examples:
              JualStokPET:
                value:
                  mitra: 1
                  kategori: 1
                  berat_jual_kg: '100.00'
                  harga_jual_per_kg: '2500.00'
                summary: Jual stok PET
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PenjualanMitraCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PenjualanMitraCreateRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PenjualanMitraCreate'
          description: ''
  /api/partner-sales/{id}/:
    get:
      operationId: partner_sales_retrieve
      summary: Detail penjualan
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this penjualan mitra.
        required: true
      tags:
      - Partner Sales
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PenjualanMitra'
          description: ''
  /api/partners/:
    get:
      operationId: partners_list
      summary: Daftar mitra pengepul
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - Partners
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedMitraPengepulList'
          description: ''
    post:
      operationId: partners_create
      summary: Tambah mitra (admin)
      tags:
      - Partners
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/MitraPengepulRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/MitraPengepulRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/MitraPengepulRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MitraPengepul'
          description: ''
  /api/partners/{id}/:
    get:
      operationId: partners_retrieve
      summary: Detail mitra
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this mitra pengepul.
        required: true
      tags:
      - Partners
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MitraPengepul'
          description: ''
    put:
      operationId: partners_update
      summary: Perbarui mitra
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this mitra pengepul.
        required: true
      tags:
      - Partners
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/MitraPengepulRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/MitraPengepulRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/MitraPengepulRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MitraPengepul'
          description: ''
    patch:
      operationId: partners_partial_update
      summary: Perbarui mitra
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this mitra pengepul.
        required: true
      tags:
      - Partners
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedMitraPengepulRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedMitraPengepulRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedMitraPengepulRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MitraPengepul'
          description: ''
    delete:
      operationId: partners_destroy
      summary: Hapus mitra
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this mitra pengepul.
        required: true
      tags:
      - Partners
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '204':
          description: No response body
  /api/pickups/:
    get:
      operationId: pickups_list
      summary: Daftar penjemputan
      parameters:
      - in: query
        name: nasabah
        schema:
          type: integer
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: petugas
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
          enum:
          - dalam_perjalanan
          - dijadwalkan
          - dijemput
          - disetujui
          - ditolak
          - menunggu
          - selesai
        description: '* `menunggu` - Menunggu

          * `disetujui` - Disetujui

          * `dijadwalkan` - Dijadwalkan

          * `dalam_perjalanan` - Dalam Perjalanan

          * `dijemput` - Dijemput

          * `selesai` - Selesai

          * `ditolak` - Ditolak'
      tags:
      - Pickups
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedPenjemputanList'
          description: ''
    post:
      operationId: pickups_create
      summary: Ajukan penjemputan (nasabah)
      tags:
      - Pickups
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PenjemputanCreateRequest'
            examples:
              AjuanPenjemputan:
                value:
                  estimasi_berat: '8.00'
                  alamat_jemput: Jl. Cendrawasih, Timika
                  jadwal: '2026-07-08T09:00:00+09:00'
                  catatan: Sampah sudah dipilah
                summary: Ajuan penjemputan
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PenjemputanCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PenjemputanCreateRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PenjemputanCreate'
          description: ''
  /api/pickups/{id}/:
    get:
      operationId: pickups_retrieve
      summary: Detail penjemputan
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this penjemputan.
        required: true
      tags:
      - Pickups
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Penjemputan'
          description: ''
    patch:
      operationId: pickups_partial_update
      summary: Perbarui penjemputan
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this penjemputan.
        required: true
      tags:
      - Pickups
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedPenjemputanUpdateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedPenjemputanUpdateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedPenjemputanUpdateRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PenjemputanUpdate'
          description: ''
  /api/pickups/{id}/approve/:
    post:
      operationId: pickups_approve_create
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this penjemputan.
        required: true
